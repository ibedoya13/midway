{
  "name": "midway",
  "private": true,
  "version": "0.1.0",
  "description": "Juego para dos jugadores con estética pixel art (Vue + Go/WebSocket)",
  "workspaces": [
    "apps/midway"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/midway run dev",
    "build:web": "npm --workspace apps/midway run build",
    "test:web": "npm --workspace apps/midway run test",
    "lint:web": "npm --workspace apps/midway run lint",
    "typecheck:web": "npm --workspace apps/midway run typecheck"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.8",
    "glob@>=9.0.0 <14.0.2": "^14.0.6"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  }
}
