{
  "name": "midway",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "build:prod": "node scripts/check-build-url.mjs --precheck && vite build && node scripts/check-build-url.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "vue-tsc --build --force"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@cloudflare/config": "^0.32.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/ui": "^5.1.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^14.0.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.65.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.0.7",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
